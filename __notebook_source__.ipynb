import pandas as pd
import numpy as np
from sqlalchemy import create_engine
import os

# Load the dataset
df = pd.read_csv("/kaggle/input/datasets/ahswena/nse-nifty50/National_Stock_Exchange_of_India_Ltd.csv")
print(df.shape)
print(df.columns.tolist())
df.head()


# Columns that have commas inside numbers like "3,101.00"
numeric_cols = ['Open','High','Low','LTP','Chng','% Chng',
                'Volume (lacs)','Turnover (crs.)','52w H',
                '52w L','365 d % chng','30 d % chng']

for col in numeric_cols:
    df[col] = df[col].astype(str).str.replace(',', '', regex=False)
    df[col] = pd.to_numeric(df[col], errors='coerce')

# Rename columns to clean names
df.columns = ['Symbol','Open','High','Low','LTP','Change',
              'Pct_Change','Volume_Lacs','Turnover_Crs',
              'High_52w','Low_52w','Return_365d','Return_30d']

print(df.dtypes)
print(f"Null values:\n{df.isnull().sum()}")


sector_map = {
    'TATASTEEL':'Metals','JSWSTEEL':'Metals','HINDALCO':'Metals',
    'COALINDIA':'Energy','ONGC':'Energy','BPCL':'Energy',
    'IOC':'Energy','NTPC':'Energy','POWERGRID':'Energy',
    'INFY':'IT','TCS':'IT','WIPRO':'IT','HCLTECH':'IT','TECHM':'IT',
    'HDFCBANK':'Banking','ICICIBANK':'Banking','AXISBANK':'Banking',
    'KOTAKBANK':'Banking','SBIN':'Banking','INDUSINDBK':'Banking',
    'BAJFINANCE':'NBFC','BAJAJFINSV':'NBFC','HDFCLIFE':'Insurance',
    'SBILIFE':'Insurance',
    'HINDUNILVR':'FMCG','ITC':'FMCG','NESTLEIND':'FMCG',
    'BRITANNIA':'FMCG','TATACONSUM':'FMCG',
    'SUNPHARMA':'Pharma','CIPLA':'Pharma','DRREDDY':'Pharma','DIVISLAB':'Pharma',
    'RELIANCE':'Conglomerate','LT':'Infrastructure',
    'MARUTI':'Auto','TATAMOTORS':'Auto','M&M':'Auto',
    'HEROMOTOCO':'Auto','BAJAJ-AUTO':'Auto','EICHERMOT':'Auto',
    'TITAN':'Consumer','ASIANPAINT':'Consumer',
    'ADANIPORTS':'Logistics','BHARTIARTL':'Telecom',
    'GRASIM':'Cement','SHREECEM':'Cement','ULTRACEMCO':'Cement',
    'HDFC':'Banking','UPL':'Chemicals'
}

df['Sector'] = df['Symbol'].map(sector_map)
print(df[['Symbol','Sector']].head(10))


# 52-week price position (where is current price in 52w range)
df['Range_52w'] = df['High_52w'] - df['Low_52w']
df['Position_in_52w_Range'] = ((df['LTP'] - df['Low_52w']) / df['Range_52w'] * 100).round(2)

# Intraday range %
df['Intraday_Range_Pct'] = ((df['High'] - df['Low']) / df['Low'] * 100).round(2)

# Momentum score (combination of 30d and 365d returns)
df['Momentum_Score'] = (0.4 * df['Return_30d'] + 0.6 * df['Return_365d']).round(2)

# Flag high volume stocks (above median)
median_vol = df['Volume_Lacs'].median()
df['High_Volume_Flag'] = (df['Volume_Lacs'] > median_vol).astype(int)

print(df[['Symbol','Position_in_52w_Range','Momentum_Score']].sort_values('Momentum_Score', ascending=False))


sector_summary = df.groupby('Sector').agg(
    Avg_Return_365d  = ('Return_365d', 'mean'),
    Avg_Return_30d   = ('Return_30d',  'mean'),
    Avg_Momentum     = ('Momentum_Score','mean'),
    Total_Turnover   = ('Turnover_Crs', 'sum'),
    Avg_52w_Position = ('Position_in_52w_Range','mean'),
    Stock_Count      = ('Symbol','count')
).round(2).reset_index()

print(sector_summary.sort_values('Avg_Return_365d', ascending=False))


engine = create_engine("sqlite:////kaggle/working/nse_financial.db")

# Table 1: raw cleaned snapshot
df.to_sql("nifty50_snapshot", engine, if_exists="replace", index=False)

# Table 2: computed metrics per stock
metrics_df = df[['Symbol','Sector','Position_in_52w_Range',
                 'Intraday_Range_Pct','Momentum_Score','High_Volume_Flag']]
metrics_df.to_sql("computed_metrics", engine, if_exists="replace", index=False)

# Table 3: sector summary
sector_summary.to_sql("sector_summary", engine, if_exists="replace", index=False)

# Verify with SQL query
result = pd.read_sql("""
    SELECT Sector, 
           ROUND(AVG(Momentum_Score),2) as Avg_Momentum,
           COUNT(*) as Stocks
    FROM computed_metrics
    GROUP BY Sector
    ORDER BY Avg_Momentum DESC
""", engine)
print(result)


df.to_csv("/kaggle/working/nifty50_clean.csv", index=False)
sector_summary.to_csv("/kaggle/working/sector_summary.csv", index=False)

print("Output files:")
for f in os.listdir("/kaggle/working"):
    print(f"  {f}")
